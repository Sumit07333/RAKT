# RaktNavi Backend Environment Configuration (Template)
# Copy this file to .env and configure values for your environment.
# Never commit real credentials or production secrets to version control.

# Application Settings
APP_NAME=RaktNavi API
APP_ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/raktnavi_db

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs; credentials supported only with explicit origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Blood Inventory Freshness Threshold (hours before record is marked stale)
STALE_THRESHOLD_HOURS=24

# Maximum allowed payload size in bytes (e.g., 256KB = 262144)
MAX_REQUEST_BODY_BYTES=262144
